# ─── Cognimosity Backend Environment Variables ─────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Google Gemini API Key — required for roadmap generation
GOOGLE_GENERATIVE_AI_API_KEY=

# Upstash Redis — required for caching
# These are automatically set when you add Upstash Redis from the Vercel Integrations/Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
