# ─── Cognimosity Backend Environment Variables ─────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Google Gemini API Key — required for roadmap generation
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel KV (Redis) — required for caching
# These are automatically set when you link a Vercel KV store via the Vercel dashboard.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
